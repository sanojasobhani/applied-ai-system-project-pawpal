
@'
classDiagram
    class Owner {
        +String name
        +String contact_info
        +String available_hours
        +List~Pet~ pets
        +set_availability()
        +set_preference()
        +can_schedule(task_time)
        +add_pet()
    }

    class Pet {
        +String name
        +String species
        +int age
        +String health_notes
        +List~String~ needs
        +add_need()
        +update_health_notes()
        +daily_requirements()
    }

    class Task {
        +String title
        +String category
        +int duration
        +String priority
        +String preferred_time
        +String recurrence
        +String status
        +String notes
        +mark_complete()
        +reschedule()
        +conflicts_with(other_task)
        +priority_score()
    }

    class Scheduler {
        +Owner owner
        +List~Task~ tasks
        +String constraints
        +generate_plan()
        +sort_tasks()
        +filter_tasks()
        +resolve_conflicts()
        +explain_plan()
    }

    Owner "1" -- "0..*" Pet
    Scheduler o-- Owner
    Scheduler o-- Task
'@ | Set-Content .\diagrams\uml.mmd -Encoding UTF8